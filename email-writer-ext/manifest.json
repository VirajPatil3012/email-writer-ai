{
  "name": "EMAIL WRITER ASSISTANT",
  "description": "AI-powered email reply generator",
  "version": "1.0",
  "manifest_version": 3,

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "https://email-writer-backend-vigy.onrender.com/*",
    "*://mail.google.com/*"
  ],

  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["*://mail.google.com/*"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["*://mail.google.com/*"]
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Email Writer Assistant",
    "default_popup": "popup.html"
  }
}